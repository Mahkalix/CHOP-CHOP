# Supabase: Project Settings > Database > Connection string
# Pooler URL (used by the API at runtime)
DATABASE_URL=
# Direct connection (used only by `pnpm db:migrate`), optional
DIRECT_URL=
# Supabase project URL (Project Settings > API), used to verify player access tokens
SUPABASE_URL=https://<project-ref>.supabase.co
PORT=3000
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*
# Set to true when the API runs behind a reverse proxy (Render, Fly, Railway...)
TRUST_PROXY=false
